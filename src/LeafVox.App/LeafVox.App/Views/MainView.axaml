<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LeafVox.App.ViewModels"
             x:Class="LeafVox.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Brush.Abyss}">

  <!-- Observatory Night app shell (see .impeccable/surfaces/app-shell.md).
       One accent: Open action, spoken-line annotation, play state, scrubs. -->

  <DockPanel>

    <!-- ─────────────────────── Command deck ─────────────────────── -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1"
            Padding="10,7">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
        <Button Classes="room" Content="Open PDF" Click="OnOpenClick"/>

        <Button Classes="deck" Grid.Column="1" Margin="10,0,0,0" Content="Recent">
          <Button.Flyout>
            <MenuFlyout Opening="OnRecentOpening"/>
          </Button.Flyout>
        </Button>

        <Button Classes="deck" Grid.Column="2" Content="{Binding ViewLabel}" Margin="2,0,0,0"
                ToolTip.Tip="Toggle page / flow view" Command="{Binding ToggleViewCommand}"/>

        <Button Classes="deck" Grid.Column="3" Margin="2,0,0,0" ToolTip.Tip="Bookmark this line"
                Command="{Binding ToggleBookmarkCommand}">
          <Path Width="15" Height="15" Stretch="Uniform"
                Data="M8,1.7 L9.9,5.5 L14.1,6.1 L11,9.1 L11.7,13.3 L8,11.3 L4.3,13.3 L5,9.1 L1.9,6.1 L6.1,5.5 Z"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                StrokeJoin="Round" Fill="Transparent"/>
        </Button>

        <Button Classes="deck" Grid.Column="4" Margin="2,0,0,0" ToolTip.Tip="Bookmarks">
          <Path Width="16" Height="16" Stretch="Uniform"
                Data="M4.5,2.5 H11.5 V13.5 L8,10.5 L4.5,13.5 Z"
                Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                StrokeJoin="Round" Fill="Transparent">
          </Path>
          <Button.Flyout>
            <MenuFlyout Opening="OnBookmarksOpening"/>
          </Button.Flyout>
        </Button>

        <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="2" Margin="8,0">
          <TextBlock Classes="deckTitle" Text="{Binding BookTitle}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Classes="micro statusHot" Classes.statusHot="{Binding StatusHot}"
                     Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button Classes="deck" Grid.Column="6" Content="OCR" IsVisible="{Binding HasScannedPages}"
                ToolTip.Tip="Recover text from scanned pages (free, local)"
                Command="{Binding OcrScannedCommand}"/>

        <Button Classes="chip" Grid.Column="7" Margin="10,0,0,0" Content="{Binding VoiceLabel}"
                ToolTip.Tip="Free local voices" Click="OnVoicesClick"/>
      </Grid>
    </Border>

    <!-- ─────────────────────── Transport rail ─────────────────────── -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto">
        <!-- 2px playing line: the rail's underline progress, accent only while speaking -->
        <Border Grid.Row="0" Height="2" Background="{DynamicResource Brush.Accent}"
                IsVisible="{Binding IsPlaying}"/>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="10,6" VerticalAlignment="Top">

          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="transport" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous line">
              <Path Width="16" Height="16" Stretch="Uniform" Data="M4,11 L8,7 L12,11"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                    StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
            </Button>
            <Button Classes="transport play" Command="{Binding TogglePlayCommand}" ToolTip.Tip="Play / pause">
              <Grid>
                <!-- pause: two bars; play: right-pointing wedge -->
                <Path Width="18" Height="18" Stretch="Uniform" IsVisible="{Binding IsPlaying}"
                      Data="M5.5,4 H7.7 V14 H5.5 Z M10.3,4 H12.5 V14 H10.3 Z"
                      Fill="{Binding $parent[Button].Foreground}"/>
                <Path Width="18" Height="18" Stretch="Uniform" IsVisible="{Binding !IsPlaying}"
                      Data="M6.5,4 V14 L14,9 Z"
                      Fill="{Binding $parent[Button].Foreground}"/>
              </Grid>
            </Button>
            <Button Classes="transport" Command="{Binding NextCommand}" ToolTip.Tip="Next line">
              <Path Width="16" Height="16" Stretch="Uniform" Data="M4,7 L8,11 L12,7"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                    StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
            </Button>
            <Button Classes="transport" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
              <Path Width="14" Height="14" Stretch="Uniform" Data="M4.5,4.5 H11.5 V11.5 H4.5 Z"
                    Fill="{Binding $parent[Button].Foreground}"/>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
            <TextBlock Classes="micro" Text="{Binding PositionLabel}" HorizontalAlignment="Center"/>
            <Slider x:Name="Scrubber" Margin="0,4,0,0" Minimum="0" Maximum="{Binding ScrubMax}"
                    Value="{Binding Scrub}" TickFrequency="1" SmallChange="1" LargeChange="1"
                    IsEnabled="{Binding HasDocument}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="chip" Content="Line once" ToolTip.Tip="Speak only the current line"
                    Command="{Binding ReadThisLineCommand}" Padding="10,4"/>
            <Button Classes="chip" Content="{Binding SleepLabel}" ToolTip.Tip="Sleep timer (15 minutes)"
                    Command="{Binding SetSleepCommand}" CommandParameter="15" Padding="10,4"/>
            <TextBlock Classes="micro" Text="speed" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Slider Width="88" Minimum="0.5" Maximum="3" TickFrequency="0.25" SmallChange="0.05"
                    Value="{Binding Speed}" VerticalAlignment="Center"/>
            <TextBlock Classes="micro" Text="{Binding SpeedLabel}" Width="30" TextAlignment="Right"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- ─────────────────────── Reader area ─────────────────────── -->
    <Grid>

      <!-- Empty state: the desk teaches its own interface -->
      <Panel IsVisible="{Binding !HasDocument}" Background="{DynamicResource Brush.Abyss}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <Path Width="42" Height="42" Stretch="Uniform" HorizontalAlignment="Center"
                Data="M14,3 C21,6 24,12 21,19 C14,22 6,19 4,12 C8,6 10,4.5 14,3 Z M22.5,21 L27,26"
                Stroke="{DynamicResource Brush.Chalk.Faint}" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
          <TextBlock Text="Open a PDF to begin listening" FontSize="15"
                     Foreground="{DynamicResource Brush.Chalk.Secondary}"
                     HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock Classes="micro" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Brush.Chalk.Faint}"
                     Text="Space play  ·  ← → line  ·  Esc stop"/>
        </StackPanel>
      </Panel>

      <Grid IsVisible="{Binding HasDocument}">

        <!-- Flow view: banded rows, amber marker on the spoken line -->
        <ListBox x:Name="SentenceList" Classes="flat" IsVisible="{Binding !UsePageView}"
                 ItemsSource="{Binding Sentences}"
                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="16,12"
                 DoubleTapped="OnLineDoubleTapped" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SentenceVm">
              <Border Padding="10,7" Background="{Binding CurrentBackground}" CornerRadius="3">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="2" Margin="0,2,10,2" Background="{Binding MarkerBrush}" CornerRadius="1"/>
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"
                             LineHeight="24" Foreground="{DynamicResource Brush.Chalk}"/>
                  <TextBlock Grid.Column="2" Classes="folio" Text="{Binding PageLabel}"
                             VerticalAlignment="Top" Margin="12,3,4,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Read from here"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ReadFromSelectedCommand}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>

        <!-- Page view: the paper plate on the dark desk -->
        <ScrollViewer x:Name="PageScroll" IsVisible="{Binding UsePageView}"
                      Background="{DynamicResource Brush.Abyss}">
          <ItemsRepeater x:Name="PageRepeater" ItemsSource="{Binding Pages}">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Vertical" Spacing="12"/>
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:PageVm">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                        Background="Transparent" DoubleTapped="OnPageDoubleTapped">
                    <Image Source="{Binding Image}"/>
                    <ItemsControl ItemsSource="{Binding HighlightBoxes}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HighlightBoxVm">
                          <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                     Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                     Fill="{DynamicResource Brush.Accent.Wash}"
                                     Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.2"
                                     RadiusX="3" RadiusY="3"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <TextBlock Classes="folio" HorizontalAlignment="Center" Text="{Binding PageLabel}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
