<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LeafVox.App.ViewModels"
        x:Class="LeafVox.App.Views.VoiceManagerWindow"
        x:DataType="vm:VoiceManagerViewModel"
        Title="Free voices"
        Width="640" Height="560"
        Background="{DynamicResource Brush.Abyss}"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16,14">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Voices" Classes="deckTitle" FontSize="15"/>
        <TextBlock Text="{Binding Status}" Classes="micro" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="chip" Content="Re-scan" VerticalAlignment="Center"
              Command="{Binding RefreshCommand}"/>
    </Grid>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Voices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:VoiceItemVm">
            <!-- Catalog row: hairline-banded, warm only through the installed state -->
            <Border Padding="2,12" BorderBrush="{DynamicResource Brush.Hairline}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Grid.RowSpan="3" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Chalk}"/>
                  <TextBlock Classes="micro">
                    <Run Text="{Binding Language}"/><Run Text="  ·  "/><Run Text="{Binding TierLabel}"/><Run Text="  ·  "/><Run Text="{Binding SizeLabel}"/><Run Text="  ·  "/><Run Text="{Binding LicenseLabel}"/>
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="micro" Text="{Binding StateLabel}"
                               IsVisible="{Binding !IsInstalled}"
                               Foreground="{DynamicResource Brush.Chalk.Faint}"/>
                    <Border IsVisible="{Binding IsInstalled}"
                            Background="{DynamicResource Brush.Accent.Ghost}"
                            CornerRadius="3" Padding="6,2">
                      <TextBlock Text="installed" FontSize="11" FontWeight="Medium"
                                 Foreground="{DynamicResource Brush.Ready}"/>
                    </Border>
                  </StackPanel>
                  <ProgressBar Grid.Row="2" Value="{Binding Progress}" Maximum="100"
                               IsVisible="{Binding Busy}" Height="3" MinWidth="160"
                               HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Spacing="6">
                  <Button Classes="chip" Content="Download" Padding="14,5"
                          Command="{Binding InstallCommand}"
                          IsVisible="{Binding !IsInstalled}"/>
                  <Button Classes="chip" Content="Use this" Padding="14,5"
                          Command="{Binding UseCommand}"
                          IsVisible="{Binding IsInstalled}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
