<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Native sherpa-onnx runtime for the build host's OS/arch (each publish target builds on its own OS). -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeafVox.App\LeafVox.App.csproj" />
  </ItemGroup>
</Project>
